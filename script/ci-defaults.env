export SESSIONS_WEB_SMOKE_GATE="${SESSIONS_WEB_SMOKE_GATE:-1}"  # default on (#1887); 005-SessionsWeb cookie curls
export SESSIONS_WEB_AOT_LINK_GATE="${SESSIONS_WEB_AOT_LINK_GATE:-1}"  # default on (#1946); set 0 to skip 005 link during iteration
export SESSIONS_WEB_AOT_SMOKE_GATE="${SESSIONS_WEB_AOT_SMOKE_GATE:-0}"  # opt-in (#1891); flip to 1 when stable (#1923)
export MINIWEBAPP_AOT_LINK_GATE="${MINIWEBAPP_AOT_LINK_GATE:-1}"
export MINIWEBAPP_AOT_EXECUTE_GATE="${MINIWEBAPP_AOT_EXECUTE_GATE:-1}"  # default on (#747)
export MINIWEBAPP_JIT_PROJECT_GATE="${MINIWEBAPP_JIT_PROJECT_GATE:-0}"  # opt-in (#587)
export MINIWEBAPP_SERVE_AOT_GATE="${MINIWEBAPP_SERVE_AOT_GATE:-1}"  # default on (#1524, #1067)
export EXAMPLES_AOT_SMOKE_GATE="${EXAMPLES_AOT_SMOKE_GATE:-1}"
export DEPLOY_SMOKE_GATE="${DEPLOY_SMOKE_GATE:-1}"
