export ROOT_README_SYNC_GATE="${ROOT_README_SYNC_GATE:-1}"  # default on (#1832, #1525); opt-out ROOT_README_SYNC_GATE=0 for doc-only iteration
export ROOT_README_006_SYNC_GATE="${ROOT_README_006_SYNC_GATE:-1}"  # default on (#2017, #2052); opt-out ROOT_README_006_SYNC_GATE=0 for doc-only iteration
export ROOT_README_007_SYNC_GATE="${ROOT_README_007_SYNC_GATE:-1}"  # default on (#2094); opt-out ROOT_README_007_SYNC_GATE=0 for doc-only iteration
export DEVELOPMENT_STATUS_SYNC_GATE="${DEVELOPMENT_STATUS_SYNC_GATE:-1}"  # default on (#2067, #2083); opt-out DEVELOPMENT_STATUS_SYNC_GATE=0 for doc-only iteration
export SELFHOST_SPINE_COUNT_SYNC_GATE="${SELFHOST_SPINE_COUNT_SYNC_GATE:-1}"  # default on (#1834); opt-out for bulk spine PRs
export SELFHOST_SPINE_COVERAGE_SYNC_GATE="${SELFHOST_SPINE_COVERAGE_SYNC_GATE:-1}"  # default on (#1955, #1945, #1922); opt-out for bulk spine path-only PRs
export SELFHOST_M4_GEN2_SYNC_GATE="${SELFHOST_M4_GEN2_SYNC_GATE:-0}"  # opt-in (#2115); flip default-on after #2075 native gen-2 emit
export BOOTSTRAP_M3_COMPILE_SMOKE_PROBE_GATE="${BOOTSTRAP_M3_COMPILE_SMOKE_PROBE_GATE:-1}"  # default on (#1937); partial Zend emit + native run
export BOOTSTRAP_M3_COMPILE_SMOKE_STRICT_GATE="${BOOTSTRAP_M3_COMPILE_SMOKE_STRICT_GATE:-0}"  # opt-in (#1937); flip to 1 when native compile-smoke emit lands
export M3_ALLOWLIST_SYNC_GATE="${M3_ALLOWLIST_SYNC_GATE:-1}"  # default on (#1905); opt-out M3_ALLOWLIST_SYNC_GATE=0 for bulk symbol PRs
export BOOTSTRAP_M5_DOC_SYNC_GATE="${BOOTSTRAP_M5_DOC_SYNC_GATE:-1}"  # default on (#1984); opt-out BOOTSTRAP_M5_DOC_SYNC_GATE=0 for doc-only iteration
export BOOTSTRAP_VENDOR_INVENTORY_SYNC_GATE="${BOOTSTRAP_VENDOR_INVENTORY_SYNC_GATE:-1}"  # default on (#2040, #2030); opt-out BOOTSTRAP_VENDOR_INVENTORY_SYNC_GATE=0 for vendor-only iteration
export INIT_MINIWEBAPP_PARITY_GATE="${INIT_MINIWEBAPP_PARITY_GATE:-1}"  # default on (#2057); opt-out INIT_MINIWEBAPP_PARITY_GATE=0 for doc-only iteration
export INIT_SESSIONSWEB_PARITY_GATE="${INIT_SESSIONSWEB_PARITY_GATE:-1}"  # default on (#1902); opt-out for doc-only iteration
export INIT_FILEUPLOAD_PARITY_GATE="${INIT_FILEUPLOAD_PARITY_GATE:-1}"  # default on (#2020); opt-out INIT_FILEUPLOAD_PARITY_GATE=0 for doc-only iteration
export INIT_THROWSWEB_PARITY_GATE="${INIT_THROWSWEB_PARITY_GATE:-1}"  # default on (#2127); opt-out INIT_THROWSWEB_PARITY_GATE=0 for doc-only iteration
export APIJSON_INIT_PARITY_GATE="${APIJSON_INIT_PARITY_GATE:-1}"  # default on (#2037); opt-out APIJSON_INIT_PARITY_GATE=0 for doc-only iteration
export CAPABILITIES_SESSIONSWEB_SYNC_GATE="${CAPABILITIES_SESSIONSWEB_SYNC_GATE:-1}"  # default on (#1947); opt-out CAPABILITIES_SESSIONSWEB_SYNC_GATE=0 for doc-only iteration
export CAPABILITIES_006_SYNC_GATE="${CAPABILITIES_006_SYNC_GATE:-1}"  # default on (#2019, #2068); opt-out CAPABILITIES_006_SYNC_GATE=0 for matrix-only edits
export CAPABILITIES_THROWS_SYNC_GATE="${CAPABILITIES_THROWS_SYNC_GATE:-0}"  # opt-in (#2144); flip to 1 after #2103 matrix rows green on master
