<?xml version="1.0" encoding="UTF-8"?>
<definitions name="BookOrderService"
  targetNamespace="urn:book"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:tns="urn:book"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <types>
    <xsd:schema targetNamespace="urn:book">
      <xsd:complexType name="Person">
        <xsd:sequence>
          <xsd:element name="name" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Book">
        <xsd:sequence>
          <xsd:element name="title" type="xsd:string"/>
          <xsd:element name="author" type="tns:Person"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="Order">
        <xsd:sequence>
          <xsd:element name="id" type="xsd:string"/>
          <!-- Same local name as Book.author but a different type — flat elementTypes collide. -->
          <xsd:element name="author" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="getBook">
        <xsd:complexType><xsd:sequence/></xsd:complexType>
      </xsd:element>
      <xsd:element name="getBookResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="return" type="tns:Book"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="getOrder">
        <xsd:complexType><xsd:sequence/></xsd:complexType>
      </xsd:element>
      <xsd:element name="getOrderResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="return" type="tns:Order"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>
  <message name="getBookRequest"><part name="parameters" element="tns:getBook"/></message>
  <message name="getBookResponse"><part name="parameters" element="tns:getBookResponse"/></message>
  <message name="getOrderRequest"><part name="parameters" element="tns:getOrder"/></message>
  <message name="getOrderResponse"><part name="parameters" element="tns:getOrderResponse"/></message>
  <portType name="BookOrderPortType">
    <operation name="getBook">
      <input message="tns:getBookRequest"/>
      <output message="tns:getBookResponse"/>
    </operation>
    <operation name="getOrder">
      <input message="tns:getOrderRequest"/>
      <output message="tns:getOrderResponse"/>
    </operation>
  </portType>
  <binding name="BookOrderBinding" type="tns:BookOrderPortType">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
    <operation name="getBook">
      <soap:operation soapAction="urn:book#getBook"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="getOrder">
      <soap:operation soapAction="urn:book#getOrder"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="BookOrderService">
    <port name="BookOrderPort" binding="tns:BookOrderBinding">
      <soap:address location="PLACEHOLDER"/>
    </port>
  </service>
</definitions>
