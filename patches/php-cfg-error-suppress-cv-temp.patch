--- vendor/ircmaxell/php-cfg/lib/PHPCfg/Parser.php
+++ vendor/ircmaxell/php-cfg/lib/PHPCfg/Parser.php
@@ -1501,12 +1501,19 @@
         $this->block = $block;
         $result = $this->parseExprNode($expr->expr);
         // Bare variable reads need a real fetch op for ZEND_CHECK_UNDEFINED_VAR (#13587).
+        // Materialize into a temp under silence so `$a = @$undef` does not re-fetch the CV
+        // after END_SILENCE (#29132). UnaryPlus would coerce null→int(0); Assign preserves null.
+        // Value-consuming `@$cv` (echo / arithmetic / call arg) must use that temp (#31881).
         if ($expr->expr instanceof Node\Expr\Variable) {
-            $this->block->children[] = new Op\Expr\UnaryPlus(
+            $tmp = new Temporary();
+            $assign = new Op\Expr\Assign(
+                $tmp,
                 $this->readVariable($result),
                 $attrs
             );
+            $this->block->children[] = $assign;
+            $result = $assign->result;
         } else {
             // Evaluate reads inside the suppress region (issue #3546; Zend ZEND_COMPILE_SILENCE).
             $result = $this->readVariable($result);
         }
